# --- Azure PostgreSQL (primary database) ---
# Endpoint is fixed by the Azure PG flexible server; SSL is enforced.
DATABASE_URL=postgresql://bbai_admin:PASSWORD@bbai.postgres.database.azure.com:5432/postgres?sslmode=require

# --- NextAuth.js (Entra ID federated sign-in) ---
# Generate the secret with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-32-plus-random-chars
NEXTAUTH_URL=https://bbai-hwhghef9d4g3bbgs.malaysiawest-01.azurewebsites.net

# --- Microsoft Entra ID app registration ---
AZURE_AD_TENANT_ID=e97b19be-5239-4635-99c9-9898cf4c3e60
AZURE_AD_CLIENT_ID=27e4e158-b10e-4c17-abe3-2119bbbcfcb6
AZURE_AD_CLIENT_SECRET=replace-with-new-secret-from-entra

# --- Azure Blob Storage (documents + report PDFs) ---
# Two containers must exist: project-documents, reports
AZURE_STORAGE_ACCOUNT_NAME=bbaistorage
AZURE_STORAGE_ACCOUNT_KEY=replace-with-key1-from-access-keys
AZURE_STORAGE_DOCS_CONTAINER=project-documents
AZURE_STORAGE_REPORTS_CONTAINER=reports

# --- Anthropic Claude API ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Email (Resend) ---
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=pmo@jcorp.com.my
RESEND_FROM_NAME="JCorp PMPlatform"

# --- Microsoft Teams webhook (optional) ---
TEAMS_WEBHOOK_URL=

# --- Cron secret (protects scheduled endpoints) ---
CRON_SECRET=replace-with-a-long-random-string

# --- App ---
NEXT_PUBLIC_APP_URL=https://bbai-hwhghef9d4g3bbgs.malaysiawest-01.azurewebsites.net
NEXT_PUBLIC_APP_NAME="JCorp PMPlatform"

# --- DEPRECATED: Supabase (removed in stage 6) ---
# Leave these set during stages 1-5 so the app keeps running; delete once
# data migration is validated on Azure.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
