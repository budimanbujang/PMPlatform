{
  "name": "pmplatform",
  "version": "0.1.0",
  "private": true,
  "description": "JCorp Digital PMO Platform — source of truth for every project running in JCorp HoldCo",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "db:seed": "supabase db reset && psql $DATABASE_URL -f supabase/seed/iris.sql",
    "db:types": "supabase gen types typescript --local > src/types/database.ts",
    "test": "playwright test",
    "test:e2e": "playwright test tests/e2e",
    "cron:reminders": "tsx scripts/run-reminders.ts",
    "cron:reports": "tsx scripts/run-reports.ts",
    "preflight": "tsx scripts/preflight.ts",
    "bootstrap-admin": "tsx scripts/bootstrap-admin.ts",
    "seed-users": "tsx scripts/seed-users.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@hookform/resolvers": "^5.2.0",
    "@react-pdf/renderer": "^4.3.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.48.0",
    "@tanstack/react-query": "^5.66.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.476.0",
    "next": "14.2.25",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.54.0",
    "recharts": "^2.15.0",
    "resend": "^4.1.0",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.13.0",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.19.0",
    "eslint-config-next": "14.2.25",
    "postcss": "^8.5.1",
    "supabase": "^2.9.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
